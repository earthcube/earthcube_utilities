prefix schema: <https://schema.org/>

# Count how many JSON-LD Datasets have distribution URLs for a specific repo
SELECT (COUNT(DISTINCT ?dataset) as ?datasetcount)
WHERE {
  GRAPH ?g {
    ?dataset a schema:Dataset .
    ?dataset schema:distribution ?dist .
    ?dist schema:url|schema:contentUrl ?url .
  }
  FILTER( CONTAINS(str(?g), "${repo}") )
}


