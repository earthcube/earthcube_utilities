<https://wifire-data.sdsc.edu/dataset/a6ab8ee8-cff3-4ff2-9aa5-2a8cf3cdf730/resource/e8237ed9-f433-4a3a-8060-bc8c6c1635cf> <https://schema.org/encodingFormat> "laz" <urn:gleaner.io:eco:wifire:data:07b320578c5916c0d63724db78d8def6071647d4> .
