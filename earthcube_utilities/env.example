# Earthcube Utilities Environment Variables Example
# Copy this file to .env and fill in your actual values

# ==============================================================================
# Graph Database Configuration
# ==============================================================================
# GraphDB authentication credentials
GRAPHUSER=your_graphdb_username
GRAPHPASSWORD=your_graphdb_password

# ==============================================================================
# MinIO / S3 Storage Configuration
# ==============================================================================
# MinIO endpoint (hostname:port or URL)
# Default: localhost:9000
MINIO_ENDPOINT=localhost:9000
# Alternative: use S3_ENDPOINT for compatibility
# S3_ENDPOINT=localhost:9000

# MinIO access credentials
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key

# Use HTTPS for MinIO connections (true/false, 1/0, yes/no)
# Default: false
MINIO_SECURE=false

# ==============================================================================
# Portainer Configuration
# ==============================================================================
# Portainer API authentication token
# Get this from Portainer UI: User settings -> Access tokens
# Required for all portainer-* commands in qleverctl
PORTAINER_TOKEN=ptr_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

PORTAINER_URL=https://portainer.geocodes-aws-dev.earthcube.org/api/endpoints/2/docker/

# ==============================================================================
# qLever Stack Environment Variables
# ==============================================================================
# These are used when deploying qLever stacks to Portainer
# They are typically set automatically by qleverctl based on community name
# but can be overridden via --env-file
HOST=geocodes-aws-dev.earthcube.org
# Project/community name (auto-set to community slug)
PROJECT=test

# qLever configuration names (auto-set to community slug)
QLEVER_CONFIG=test
QLEVER_CONFIG_UI=test

# Docker network name for qLever stack
QLEVER_NET=test

# Docker volume name for qLever data
QLEVER_VOL=test

# ==============================================================================
# Optional: Production Example
# ==============================================================================
# For production deployments, you might use:
# PROJECT=geocodesproduction
# QLEVER_CONFIG=geocodesproduction
# QLEVER_CONFIG_UI=geocodesproduction
# QLEVER_NET=geocodesproduction
# QLEVER_VOL=geocodesproduction
